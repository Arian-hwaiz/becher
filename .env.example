# Kopiere diese Datei nach .env und trage deine Werte ein. .env kommt nie ins Git.

# Datenbank (passt zu infra/docker-compose.yml)
DATABASE_URL=postgresql://becher:becher@localhost:5432/becher

# The Odds API (https://the-odds-api.com). Jede Abfrage kostet Sportarten × Regionen × Märkte Credits.
# Kostenloser Starter-Plan: 500 Credits im Monat. Mit den Werten hier (1 Sport, 1 Region, 2 Märkte,
# alle 4 Stunden) sind das 12 Credits am Tag, ca. 360 im Monat.
ODDS_API_KEY=
# Sportarten laut Odds-API-Schlüssel, kommagetrennt (jede weitere Sportart verdoppelt die Kosten)
ODDS_API_SPORTS=soccer_germany_bundesliga
# Regionen: eu, uk, us, au
ODDS_API_REGIONS=eu
# Märkte: h2h (1X2), totals (Über/Unter), spreads (Handicap)
ODDS_API_MARKETS=h2h,totals
# Unter dieser Restmenge fragt der Collector nicht mehr ab (Reserve für Tests)
ODDS_API_MIN_REMAINING=20

# Aktive Collector, kommagetrennt: odds_api, betfair, bwin, admiral, interwetten
# Nur eigene Scraper (keine Odds-API-Credits): COLLECTORS=bwin,admiral,interwetten
# Dauerbetrieb der Scraper in eigenem Fenster: powershell -ExecutionPolicy Bypass -File scripts\start_scraper.ps1
COLLECTORS=odds_api

# Eigene Scraper (bwin, admiral): ohne Login, kosten keine Odds-API-Credits.
# Ligen als Odds-API-Schlüssel (bekannt: soccer_germany_bundesliga, soccer_germany_bundesliga2, soccer_epl)
SCRAPE_LEAGUES=soccer_germany_bundesliga,soccer_germany_bundesliga2,soccer_epl
# Mindestabstand zwischen zwei Läufen je Scraper und Pause zwischen Seitenaufrufen (Sekunden)
SCRAPE_INTERVAL_SECONDS=120
SCRAPE_DELAY_SECONDS=3

# Betfair Exchange (Phase 4): App-Key aus dem Developer-Programm, dazu entweder ein
# Session-Token (SSOID aus dem Browser nach Login) oder Benutzername/Passwort
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Event-Typen: 1 Fußball, 2 Tennis, 7522 Basketball, 7524 Eishockey
BETFAIR_EVENT_TYPES=1,2,7522
BETFAIR_HOURS_AHEAD=48

# Abfrage-Intervall in Sekunden: 14400 = alle 4 h (Starter-Plan). Mit 20K-Plan ($30) sind 900 (15 min) drin.
COLLECT_INTERVAL_SECONDS=14400

# Telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram nur bei Treffern ab diesem Prozent (konservativ)
NOTIFY_MIN_PERCENT=1.0

# Claude-API (ab Phase 6)
ANTHROPIC_API_KEY=
# Modell und Denktiefe der KI-Schicht
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
