# Kopiere diese Datei nach .env und trage deine Werte ein. .env kommt nie ins Git.

# Datenbank (passt zu infra/docker-compose.yml)
DATABASE_URL=postgresql://becher:becher@localhost:5432/becher

# The Odds API (https://the-odds-api.com), kostenloser Key reicht zum Start
ODDS_API_KEY=
# Sportarten laut Odds-API-Schlüssel, kommagetrennt
ODDS_API_SPORTS=soccer_germany_bundesliga,soccer_epl
# Regionen: eu, uk, us, au
ODDS_API_REGIONS=eu
# Märkte: h2h (1X2), totals (Über/Unter), spreads (Handicap)
ODDS_API_MARKETS=h2h,totals

# Abfrage-Intervall in Sekunden
COLLECT_INTERVAL_SECONDS=300

# Telegram (ab Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude-API (ab Phase 6)
ANTHROPIC_API_KEY=
